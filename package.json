{
  "name": "interview-prep",
  "private": true,
  "type": "module",
  "description": "Interview practice questions with unit tests (node:test, no dependencies)",
  "scripts": {
    "test": "node run-tests.js",
    "test:list": "node run-tests.js --list",
    "test:2": "node run-tests.js --series 2",
    "test:2:list": "node run-tests.js --series 2 --list",
    "test:3": "node run-tests.js --series 3",
    "test:3:list": "node run-tests.js --series 3 --list",
    "check:unanswered": "node scripts/check-unanswered.js",
    "check:no-practice": "node scripts/check-no-practice-commits.js",
    "setup": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.9",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "eslint-config-airbnb-extended": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
