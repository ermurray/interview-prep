#!/bin/sh
# Blocks pushing anything that contains commits from `practice` to `main`.
# Changes only flow one way: main -> practice. Enable once per clone with:  npm run setup
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  node scripts/check-no-practice-commits.js "$local_sha" || status=1
done
[ $status -eq 0 ] || echo "Push to main blocked: it contains commits from practice."
exit $status
